                clicked => { root.close-clicked(); }
            }
        }
    }
}

// ===== Окно «Что купить» =====
export component ShoppingWindow inherits Window {
    title: I18n.t-shopping-title;
    default-font-family: I18n.font-family;
    min-width: 420px;
    min-height: 300px;
    preferred-width: 580px;
    preferred-height: 440px;
    in-out property <[string]> lines;
    in-out property <string> note;
    callback copy-to-clipboard();
    callback close-clicked();

    background: Palette.color-scheme == ColorScheme.dark ? #1f2937 : #f8fafc;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hairline;
            clip: true;

            VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                padding: 10px;
                spacing: 6px;

                ListView {
                    vertical-stretch: 1;
                    for l in root.lines: Text {
                        text: l;
                        font-size: 13px;
                        color: Theme.text;
                        overflow: elide;
                    }
                }
            }

            if (root.lines.length == 0): Rectangle {
                width: 100%;
                height: 100%;
                Text {
                    width: 100%;
                    y: 40px;
                    horizontal-alignment: center;
                    text: I18n.t-shop-empty;
                    font-size: 13px;
                    color: Theme.muted;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.note;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                color: Theme.muted;
            }
            GhostButton {
                label: I18n.t-shop-copy;
                clicked => { root.copy-to-clipboard(); }
            }
            Button {
                text: I18n.t-close;
                clicked => { root.close-clicked(); }
            }
        }
    }
}

// ===== Окно резервных копий =====
export component BackupsWindow inherits Window {
    title: I18n.t-backups-title;
    default-font-family: I18n.font-family;
    min-width: 480px;
    min-height: 360px;
    preferred-width: 640px;
    preferred-height: 440px;
    in-out property <[string]> rows;
    in-out property <int> selected: -1;
    in-out property <string> note;
    callback restore(int);
    callback close-clicked();

    background: Palette.color-scheme == ColorScheme.dark ? #1f2937 : #f8fafc;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: I18n.t-bak-hint;
            wrap: word-wrap;
            font-size: 12px;
            color: Theme.muted;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hairline;
            clip: true;

            VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                padding: 6px;

                ListView {
                    vertical-stretch: 1;
                    for r[i] in root.rows: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: root.selected == i ? Theme.accent-tint : transparent;
                        bta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected = i; }
                        }
                        Text {
                            text: r;
                            x: 10px;
                            width: parent.width - 20px;
                            vertical-alignment: center;
                            font-size: 13px;
                            color: root.selected == i ? Theme.accent : Theme.text;
                        }
                    }
                }
            }

            if (root.rows.length == 0): Rectangle {
                width: 100%;
                height: 100%;
                Text {
                    width: parent.width - 32px;
                    x: 16px;
                    y: 32px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    text: I18n.t-bak-empty;
                    font-size: 13px;
                    color: Theme.muted;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.note;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                color: Theme.muted;
            }
            GhostButton {
                label: I18n.t-bak-restore;
                enabled: root.selected >= 0;
                clicked => { root.restore(root.selected); }
            }
            Button {
                text: I18n.t-close;
                clicked => { root.close-clicked(); }
            }
        }
    }
}

// ===== Окно импорта CSV =====
export component ImportWindow inherits Window {
    title: I18n.t-imp-title;
    default-font-family: I18n.font-family;
    min-width: 480px;
    min-height: 360px;
    preferred-width: 640px;
    preferred-height: 440px;
    in-out property <[string]> rows;
    in-out property <int> selected: -1;
    in-out property <string> note;
    callback do-import(int);
    callback close-clicked();

    background: Palette.color-scheme == ColorScheme.dark ? #1f2937 : #f8fafc;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: I18n.t-imp-hint;
            wrap: word-wrap;
            font-size: 12px;
            color: Theme.muted;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hairline;
            clip: true;

            VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                padding: 6px;

                ListView {
                    vertical-stretch: 1;
                    for r[i] in root.rows: Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: root.selected == i ? Theme.accent-tint : transparent;
                        ita := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.selected = i; }
                        }
                        Text {
                            text: r;
                            x: 10px;
                            width: parent.width - 20px;
                            vertical-alignment: center;
                            font-size: 13px;
                            color: root.selected == i ? Theme.accent : Theme.text;
                        }
                    }
                }
            }

            if (root.rows.length == 0): Rectangle {
                width: 100%;
                height: 100%;
                Text {
                    width: parent.width - 32px;
                    x: 16px;
                    y: 32px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    text: I18n.t-imp-empty;
                    font-size: 13px;
                    color: Theme.muted;
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.note;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                color: Theme.muted;
            }
            GhostButton {
                label: I18n.t-imp-import;
                enabled: root.selected >= 0;
                clicked => { root.do-import(root.selected); }
            }
            Button {
                text: I18n.t-close;
                clicked => { root.close-clicked(); }
            }
        }
    }
}
