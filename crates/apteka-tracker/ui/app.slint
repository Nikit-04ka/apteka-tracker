// Точка-индикатор статуса
component StatusDot inherits Rectangle {
    in property <int> status: 0;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: StatusTheme.base(root.status);
}

// Бейдж-пилюля: цветной фон + точка + короткий текст («12 дн.», «−45 дн.», «списано»)
component Badge inherits Rectangle {
    in property <int> status: 0;
    in property <string> text;
    height: 22px;
    horizontal-stretch: 0;
    border-radius: 11px;
    background: StatusTheme.tint(root.status);
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        VerticalLayout {
            width: 6px;
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: StatusTheme.base(root.status);
            }
        }
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 700;
            color: StatusTheme.text(root.status);
            vertical-alignment: center;
        }
    }
}

// Флажок-кнопка выбора языка: картинка из assets/flags/<код>.png, активный
// язык обведён акцентом. Языки заданы константами в Rust (apply_i18n).
component FlagButton inherits Rectangle {
    in property <image> flag;
    in property <bool> active: false;
    in property <string> tip;
    callback clicked;
    width: 30px;
    height: 24px;
    border-radius: 5px;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.accent : Theme.hairline;
    background: fta.has-hover ? Theme.accent-tint-soft : Theme.panel;
    animate border-color { duration: 90ms; easing: ease-out; }
    fta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Image {
        source: root.flag;
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        image-fit: fill; // флаги скачаны в пропорции 4:3, кнопка тоже 4:3
    }
}

// Основная кнопка (фирменный акцент)
component AccentButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    border-radius: 8px;
    background: !root.enabled ? Theme.panel
        : ta.pressed ? Theme.accent-pressed
        : ta.has-hover ? Theme.accent-hover
        : Theme.accent;
    animate background { duration: 90ms; easing: ease-out; }
    opacity: root.enabled ? 1.0 : 0.55;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 700;
            color: #ffffff;
            vertical-alignment: center;
        }
    }
}

// Вторичная кнопка-призрак; danger = красная (удаление)
component GhostButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.danger ? Theme.danger-tint : Theme.hairline;
    background: ta.pressed ? (root.danger ? Theme.danger-tint : Theme.accent-tint)
        : ta.has-hover ? (root.danger ? Theme.danger-tint : Theme.accent-tint-soft)
        : transparent;
    animate background { duration: 90ms; easing: ease-out; }
    opacity: root.enabled ? 1.0 : 0.45;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: root.danger ? Theme.danger-text
                : ta.has-hover ? Theme.accent
                : Theme.text;
            vertical-alignment: center;
        }
    }
}

// Метка поля над элементом ввода
component FieldLabel inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Theme.muted;
}

// Чип сводки
component SummaryChip inherits Rectangle {
    in property <color> dot-c;
    in property <color> label-c;
    in property <color> bg-c;
    in property <string> label;
    height: 30px;
    border-radius: 15px;
    background: root.bg-c;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            width: 8px;
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot-c;
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: root.label-c;
            vertical-alignment: center;
        }
    }
}

// Строка лекарства в списке
component MedRow inherits Rectangle {
    in property <MedicineRow> data;
    in property <bool> selected: false;
    callback clicked;

    height: 64px;
    border-radius: 8px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent
        : StatusTheme.alert-tint(root.data.status);
    background: root.selected ? Theme.accent-tint
        : StatusTheme.is-alert(root.data.status) ? StatusTheme.alert-tint(root.data.status)
        : ta.has-hover ? Theme.hover
        : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    animate border-color { duration: 100ms; easing: ease-out; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        padding: 8px;
        padding-left: 12px;
        padding-right: 10px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                width: 10px;
                alignment: center;
                StatusDot { status: root.data.status; }
            }
            Text {
                text: root.data.name;
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                color: Theme.text;
            }
            Badge {
                status: root.data.status;
                text: root.data.days-text;
            }
        }
        Text {
            text: root.data.subtitle;
            font-size: 12px;
            overflow: elide;
            color: Theme.muted;
        }
    }
}

export component AppWindow inherits Window {
    title: I18n.t-app-title;
    default-font-family: I18n.font-family;
    icon: @image-url("../assets/icon.png");
    // preferred — начальный размер окна, min — предел уменьшения при ресайзе.
    // Не задавай здесь width/height: они фиксируют размер и запрещают ресайз.
    // min-width подобран по строке кнопок карточки упаковки (5-6 кнопок + фото).
    min-width: 1280px;
    min-height: 720px;
    preferred-width: 1400px;
    preferred-height: 820px;
    forward-focus: keys;

    // ===== Данные списка =====
    in-out property <[MedicineRow]> medicines;
    in-out property <[PackageRow]> packages;
    in-out property <int> selected-id: -1;
    in-out property <bool> has-selection: false;
    in-out property <string> packages-header: I18n.t-packages-header;
    in-out property <string> list-empty-text: I18n.t-list-empty;

    // ===== Язык интерфейса (флажки в строке сводки) =====
    in-out property <string> lang-code: "ru";
    callback lang-selected(string);

    // ===== Тулбар =====
    in-out property <string> search-text: "";
    in-out property <int> filter-index: 0;
    in-out property <int> sort-index: 0;
    // Категория-фильтр: модель заполняется из Rust («Все категории» + теги)
    in-out property <[string]> tag-options: [I18n.t-all-categories];
    in-out property <int> tag-filter-index: 0;

    // ===== Детали лекарства =====
    in-out property <string> detail-name: "";
    in-out property <int> detail-form-index: 0;
    in-out property <string> detail-note: "";
    in-out property <string> detail-tags: "";
    in-out property <[string]> form-options;
    in-out property <string> delete-btn-text: I18n.t-delete-medicine;
    in-out property <bool> delete-armed: false;
    // Выбранное лекарство не попало в видимый список (поиск/фильтр) —
    // предупреждение в панели деталей, чтобы не править «невидимое» лекарство
    in-out property <bool> selected-hidden: false;

    // ===== Сводка =====
    in-out property <string> summary-total: I18n.t-summary-total;
    in-out property <string> summary-soon: I18n.t-summary-soon;
    in-out property <string> summary-expired: I18n.t-summary-expired;

    // ===== Форма упаковки =====
    in-out property <string> pkg-expiry: "";
    in-out property <string> pkg-quantity: "";
    in-out property <string> pkg-note: "";
    in-out property <bool> pkg-editing: false;
    in-out property <string> pkg-validation: "";
    in-out property <color> pkg-validation-color: Theme.muted;
    in-out property <bool> pkg-save-enabled: false;

    // ===== Статусная строка =====
    in-out property <int> warn-days: 60;
    in-out property <string> status-message: "";
    // Тема: true — тёмная; переключается кнопкой «Тема», сохраняется в settings.json
    in-out property <bool> theme-dark: false;

    // ===== Колбэки =====
    callback add-medicine();
    callback select-medicine(int);
    callback delete-medicine();
    callback name-edited(string);
    callback note-edited(string);
    callback tags-edited(string);
    callback form-selected(int);
    callback search-edited(string);
    callback filter-selected(int);
    callback tag-filter-selected(int);
    callback sort-selected(int);
    callback warn-days-changed(int);
    callback pkg-start-edit(int);
    callback pkg-delete(int);
    callback pkg-clone(int);
    callback pkg-open(int);
    // Фото у упаковки указано, но файл не читается: клик по плейсхолдеру
    // открывает диалог и прикрепляет новое фото к этой упаковке
    callback pkg-replace-photo(int);
    // Взведено подтверждение удаления лекарства — подсказка в статусной строке
    callback delete-arm-hint();
    // Enter в поле названия: принять первую подсказку автодополнения
    callback suggestion-accept();
    callback pkg-dispose(int, int);
    callback pkg-restore(int);
    callback toggle-show-disposed();
    callback open-journal();
    callback open-shopping();
    callback open-reports();
    callback open-backups();
    callback open-import();
    callback pick-photo();
    callback suggestion-picked(string);
    callback cal-month-opened();
    callback cal-prev-month();
    callback cal-next-month();
    callback cal-pick(string);
    callback pkg-save();
    callback pkg-cancel-edit();
    callback pkg-expiry-edited(string);
    callback pkg-form-edited();
    callback pkg-quick(int);
    callback export-csv();
    callback move-selection(int);
    callback undo-history();
    callback redo-history();
    callback theme-dark-changed(bool);

    // История изменений
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> save-error: false;

    // Жизненный цикл упаковок
    in-out property <bool> show-disposed: false;
    in-out property <string> summary-cost: I18n.t-summary-cost;
    in-out property <string> pkg-price: "";
    in-out property <string> pkg-period: "";
    in-out property <string> pkg-purchase-date: "";
    in-out property <string> packages-empty-text: I18n.t-packages-empty;
    in-out property <bool> pending-photo: false;
    // Двухшаговое подтверждение опасных действий над упаковкой: id упаковки,
    // для которой взведено «Точно …?» (-1 — ничего не взведено). Открытие и
    // удаление необратимы в UI одним кликом, поэтому требуют второго.
    in-out property <int> pkg-open-armed: -1;
    in-out property <int> pkg-delete-armed: -1;

    // Автодополнение названия
    in-out property <[string]> suggestions;

    // Календарь
    in-out property <string> cal-month-label: "";
    in-out property <[CalRow]> cal-weeks;

    // ===== Клавиатура: ↑/↓ — список, Ctrl+N — новое лекарство, Ctrl+F — поиск,
    // Delete — удалить (в два шага), Escape — отмена =====
    // Геометрия окна (min/preferred) задана на AppWindow — FocusScope просто
    // заполняет окно и держит горячие клавиши.
    keys := FocusScope {

        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                root.add-medicine();
                accept
            } else if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                search-input.focus();
                accept
            } else if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                if (event.modifiers.shift) {
                    root.redo-history();
                } else {
                    root.undo-history();
                }
                accept
            } else if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                root.redo-history();
                accept
            } else if (event.text == Key.UpArrow) {
                root.move-selection(-1);
                accept
            } else if (event.text == Key.DownArrow) {
                root.move-selection(1);
                accept
            } else if (event.text == Key.Delete && root.has-selection) {
                if (!root.delete-armed) {
                    root.delete-armed = true;
                    root.delete-btn-text = I18n.t-delete-confirm;
                    root.delete-arm-hint();
                } else {
                    root.delete-medicine();
                }
                accept
            } else if (event.text == Key.Escape) {
                // Escape отменяет всё взведённое: правку упаковки, подтверждение
                // удаления лекарства, подтверждения на карточке упаковки,
                // подсказки автодополнения
                if (root.pkg-editing) {
                    root.pkg-cancel-edit();
                }
                if (root.delete-armed) {
                    root.delete-armed = false;
                    root.delete-btn-text = I18n.t-delete-medicine;
                }
                root.pkg-open-armed = -1;
                root.pkg-delete-armed = -1;
                root.suggestions = [];
                accept
            } else {
                reject
            }
        }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // ===== Тулбар =====
        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 0;

            Text {
                text: I18n.t-app-header;
                font-size: 20px;
                font-weight: 800;
                vertical-alignment: center;
                color: Theme.text;
            }
            Rectangle { width: 6px; }
            search-input := LineEdit {
                text <=> root.search-text;
                placeholder-text: I18n.t-search-placeholder;
                horizontal-stretch: 1;
                vertical-stretch: 0;
                edited(text) => { root.search-edited(text); }
            }
            ComboBox {
                width: 175px;
                model: I18n.filter-options;
                current-index <=> root.filter-index;
                selected(value) => { root.filter-selected(root.filter-index); }
            }
            ComboBox {
                width: 165px;
                model: root.tag-options;
                current-index <=> root.tag-filter-index;
                selected(value) => { root.tag-filter-selected(root.tag-filter-index); }
            }
            ComboBox {
                width: 195px;
                model: I18n.sort-options;
                current-index <=> root.sort-index;
                selected(value) => { root.sort-selected(root.sort-index); }
            }
            AccentButton {
                label: I18n.t-add-medicine;
                clicked => { root.add-medicine(); }
            }
        }

        // ===== Сводка =====
        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;
            SummaryChip {
                label: root.summary-total;
                dot-c: Theme.muted;
                label-c: Theme.muted;
                bg-c: Theme.panel;
            }
            SummaryChip {
                label: root.summary-soon;
                dot-c: Theme.warn;
                label-c: Theme.warn-text;
                bg-c: Theme.warn-tint;
            }
            SummaryChip {
                label: root.summary-expired;
                dot-c: Theme.danger;
                label-c: Theme.danger-text;
                bg-c: Theme.danger-tint;
            }
            SummaryChip {
                label: root.summary-cost;
                dot-c: Theme.accent;
                label-c: Theme.text;
                bg-c: Theme.accent-tint-soft;
            }
            Rectangle { horizontal-stretch: 1; }
            // ===== Выбор языка: флажки стран (10 языков, порядок — Lang::ALL) =====
            Text {
                text: I18n.t-lang-label;
                font-size: 12px;
                vertical-alignment: center;
                color: Theme.muted;
            }
            FlagButton {
                flag: @image-url("../assets/flags/en.png");
                active: root.lang-code == "en";
                clicked => { root.lang-selected("en"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/de.png");
                active: root.lang-code == "de";
                clicked => { root.lang-selected("de"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/es.png");
                active: root.lang-code == "es";
                clicked => { root.lang-selected("es"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/fr.png");
                active: root.lang-code == "fr";
                clicked => { root.lang-selected("fr"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/it.png");
                active: root.lang-code == "it";
                clicked => { root.lang-selected("it"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/pt.png");
                active: root.lang-code == "pt";
                clicked => { root.lang-selected("pt"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/ru.png");
                active: root.lang-code == "ru";
                clicked => { root.lang-selected("ru"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/zh.png");
                active: root.lang-code == "zh";
                clicked => { root.lang-selected("zh"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/ja.png");
                active: root.lang-code == "ja";
                clicked => { root.lang-selected("ja"); }
            }
            FlagButton {
                flag: @image-url("../assets/flags/ar.png");
                active: root.lang-code == "ar";
                clicked => { root.lang-selected("ar"); }
            }
        }

        // ===== Основная область: список + детали =====
        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            // Панель списка
            Rectangle {
                width: 400px;
                horizontal-stretch: 0;
                vertical-stretch: 1;
                border-radius: 12px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.hairline;
                clip: true;

                VerticalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    padding: 6px;
                    spacing: 2px;

                    Text {
                        text: "\{I18n.t-list-header}\{root.medicines.length}";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.muted;
                        height: 22px;
                        vertical-alignment: center;
                    }

                    ListView {
                        vertical-stretch: 1;
                        for m in root.medicines: Rectangle {
                            height: 68px;
                            MedRow {
                                x: 0;
                                y: 2px;
                                width: parent.width;
                                height: 64px;
                                data: m;
                                selected: m.id == root.selected-id;
                                clicked => { root.select-medicine(m.id); }
                            }
                        }
                    }
                }

                if (root.medicines.length == 0): Rectangle {
                    width: 100%;
                    height: 100%;
                    Rectangle {
                        width: 88px;
                        height: 88px;
                        x: (parent.width - 88px) / 2;
                        y: 64px;
                        border-radius: 44px;
                        background: Theme.accent-tint-soft;
                        border-width: 2px;
                        border-color: Theme.accent-tint;
                        Rectangle {
                            width: 10px;
                            height: 40px;
                            x: (parent.width - 10px) / 2;
                            y: (parent.height - 40px) / 2;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                        Rectangle {
                            width: 40px;
                            height: 10px;
                            x: (parent.width - 40px) / 2;
                            y: (parent.height - 10px) / 2;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        width: parent.width - 48px;
                        x: 24px;
                        y: 180px;
                        text: root.list-empty-text;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        font-size: 14px;
                        color: Theme.muted;
                    }
                }
            }

            Rectangle {
                width: 1px;
                background: Theme.hairline;
            }

            // Детали выбранного лекарства
            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                if (!root.has-selection): Text {
                    width: 100%;
                    height: 100%;
                    text: I18n.t-detail-pick-hint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    font-size: 15px;
                    color: Theme.muted;
                }

                if (root.has-selection): VerticalLayout {
                    spacing: 10px;

                    if (root.selected-hidden): Text {
                        text: I18n.t-detail-hidden;
                        font-size: 11px;
                        wrap: word-wrap;
                        color: Theme.warn-text;
                    }

                    VerticalLayout {
                        spacing: 3px;
                        FieldLabel { text: I18n.t-field-name; }
                        name-edit := LineEdit {
                            text <=> root.detail-name;
                            font-size: 16px;
                            edited(text) => { root.name-edited(text); }
                            // Enter — принять первую подсказку автодополнения
                            accepted(text) => { root.suggestion-accept(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 3px;
                            width: 190px;
                            FieldLabel { text: I18n.t-field-form; }
                            ComboBox {
                                model: root.form-options;
                                current-index <=> root.detail-form-index;
                                selected(value) => { root.form-selected(root.detail-form-index); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            spacing: 3px;
                            width: 190px;
                            alignment: end;
                            FieldLabel { text: I18n.t-field-actions; }
                            GhostButton {
                                label: root.delete-btn-text;
                                danger: true;
                                clicked => {
                                    if (!root.delete-armed) {
                                        root.delete-armed = true;
                                        root.delete-btn-text = I18n.t-delete-confirm;
                                        root.delete-arm-hint();
                                    } else {
                                        root.delete-medicine();
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        FieldLabel { text: I18n.t-field-notes; }
                        TextEdit {
                            height: 44px;
                            vertical-stretch: 0;
                            text <=> root.detail-note;
                            edited(text) => { root.note-edited(text); }
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;
                        FieldLabel { text: I18n.t-field-tags; }
                        LineEdit {
                            text <=> root.detail-tags;
                            placeholder-text: I18n.t-tags-placeholder;
                            edited(text) => { root.tags-edited(text); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.packages-header;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                            color: Theme.text;
                        }
                        Text {
                            text: I18n.t-packages-hint;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                            color: Theme.muted;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        GhostButton {
                            label: root.show-disposed ? I18n.t-hide-disposed : I18n.t-show-disposed;
                            clicked => { root.toggle-show-disposed(); }
                        }
                    }

                    // Таблица упаковок — карточки
                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 70px;
                        border-radius: 12px;
                        background: Theme.panel;
                        border-width: 1px;
                        border-color: Theme.hairline;
                        clip: true;

                        VerticalLayout {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            padding: 6px;

                            ListView {
                                vertical-stretch: 1;
                                for p in root.packages: Rectangle {
                                    height: 80px;
                                    Rectangle {
                                        x: 0;
                                        y: 3px;
                                        width: parent.width;
                                        height: 74px;
                                        border-radius: 8px;
                                        background: Theme.card;
                                        border-width: 1px;
                                        border-color: Theme.hairline;
                                        drop-shadow-blur: 5px;
                                        drop-shadow-offset-y: 1px;
                                        drop-shadow-color: Palette.color-scheme == ColorScheme.dark ? transparent : rgba(15, 23, 42, 0.08);
                                        opacity: p.disposed ? 0.6 : 1.0;

                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 8px;
                                            padding-top: 8px;
                                            padding-bottom: 8px;
                                            spacing: 10px;

                                            VerticalLayout {
                                                width: 10px;
                                                alignment: center;
                                                StatusDot { status: StatusTheme.row-status(p.disposed, p.status); }
                                            }
                                            if (p.photo.width > 0): Image {
                                                source: p.photo;
                                                width: 52px;
                                                height: 58px;
                                                image-fit: contain;
                                            }
                                            if (p.photo-missing): Rectangle {
                                                width: 52px;
                                                height: 58px;
                                                border-radius: 6px;
                                                background: pta.has-hover ? Theme.accent-tint-soft : Theme.panel;
                                                border-width: 1px;
                                                border-color: pta.has-hover ? Theme.accent : Theme.hairline;
                                                pta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.pkg-replace-photo(p.id); }
                                                }
                                                Text {
                                                    width: 100%;
                                                    text: I18n.t-photo-missing;
                                                    font-size: 8px;
                                                    color: Theme.muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                horizontal-stretch: 1;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text {
                                                        text: p.expiry;
                                                        font-size: 15px;
                                                        font-weight: 700;
                                                        vertical-alignment: center;
                                                        color: Theme.text;
                                                    }
                                                    Text {
                                                        text: p.quantity;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                        color: Theme.muted;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Text {
                                                        text: p.price;
                                                        font-size: 12px;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                        color: Theme.muted;
                                                    }
                                                    Badge {
                                                        status: StatusTheme.row-status(p.disposed, p.status);
                                                        text: p.days-text;
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    if (p.opened-info != ""): Text {
                                                        text: p.opened-info;
                                                        font-size: 11px;
                                                        vertical-alignment: center;
                                                        color: Theme.accent;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: p.note;
                                                        font-size: 12px;
                                                        overflow: elide;
                                                        color: Theme.muted;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    if (!p.disposed && !p.opened): GhostButton {
                                                        // открытие одним кликом отмечает
                                                        // упаковку вскрытой «навсегда»
                                                        // (кнопки «не открыт» в UI нет) —
                                                        // поэтому двухшагово
                                                        label: root.pkg-open-armed == p.id ? I18n.t-pkg-open-confirm : I18n.t-pkg-open;
                                                        clicked => {
                                                            if (root.pkg-open-armed == p.id) {
                                                                root.pkg-open-armed = -1;
                                                                root.pkg-open(p.id);
                                                            } else {
                                                                root.pkg-open-armed = p.id;
                                                                root.pkg-delete-armed = -1;
                                                            }
                                                        }
                                                    }
                                                    if (!p.disposed && p.opened): GhostButton {
                                                        label: I18n.t-pkg-used;
                                                        clicked => { root.pkg-dispose(p.id, 0); }
                                                    }
                                                    // выбросить можно и запечатанную
                                                    // (например, просроченную) пачку
                                                    if (!p.disposed): GhostButton {
                                                        label: I18n.t-pkg-discard;
                                                        danger: true;
                                                        clicked => { root.pkg-dispose(p.id, 1); }
                                                    }
                                                    if (!p.disposed): GhostButton {
                                                        label: I18n.t-pkg-clone;
                                                        clicked => { root.pkg-clone(p.id); }
                                                    }
                                                    if (!p.disposed): GhostButton {
                                                        label: I18n.t-pkg-edit;
                                                        clicked => { root.pkg-start-edit(p.id); }
                                                    }
                                                    if (p.disposed): GhostButton {
                                                        label: I18n.t-pkg-restore;
                                                        clicked => { root.pkg-restore(p.id); }
                                                    }
                                                    GhostButton {
                                                        // удаление — как у лекарства:
                                                        // два нажатия, между ними
                                                        // кнопка меняет текст
                                                        label: root.pkg-delete-armed == p.id ? I18n.t-delete-confirm
                                                            : p.disposed ? I18n.t-pkg-delete-forever : I18n.t-pkg-delete;
                                                        danger: true;
                                                        clicked => {
                                                            if (root.pkg-delete-armed == p.id) {
                                                                root.pkg-delete-armed = -1;
                                                                root.pkg-delete(p.id);
                                                            } else {
                                                                root.pkg-delete-armed = p.id;
                                                                root.pkg-open-armed = -1;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if (root.packages.length == 0): Rectangle {
                            width: 100%;
                            height: 100%;
                            Text {
                                width: parent.width - 48px;
                                x: 24px;
                                y: 24px;
                                text: root.packages-empty-text;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                font-size: 13px;
                                color: Theme.muted;
                            }
                        }
                    }

                    // Форма упаковки
                    Rectangle {
                        vertical-stretch: 0;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.hairline;
                        background: Theme.panel;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            Text {
                                text: root.pkg-editing ? I18n.t-form-edit
                                    : root.pending-photo ? I18n.t-form-new-photo
                                    : I18n.t-form-new;
                                font-size: 13px;
                                font-weight: 700;
                                color: root.pkg-editing ? Theme.accent : Theme.text;
                            }

                            // Две строки по три поля: шесть полей в ряд шире панели
                            // и обрезаются на узких окнах.
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    spacing: 3px;
                                    horizontal-stretch: 2;
                                    FieldLabel { text: I18n.t-field-expiry; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        expiry-edit := LineEdit {
                                            horizontal-stretch: 1;
                                            text <=> root.pkg-expiry;
                                            placeholder-text: I18n.t-expiry-placeholder;
                                            edited(text) => { root.pkg-expiry-edited(text); }
                                        }
                                        GhostButton {
                                            width: 38px;
                                            label: "▼";
                                            clicked => {
                                                root.cal-month-opened();
                                                cal-popup.show();
                                            }
                                        }
                                    }
                                    cal-popup := PopupWindow {
                                        width: 262px;
                                        height: 330px;
                                        Rectangle {
                                            border-radius: 10px;
                                            background: Theme.card;
                                            border-width: 1px;
                                            border-color: Theme.hairline;
                                            VerticalLayout {
                                                padding: 8px;
                                                spacing: 4px;

                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    GhostButton {
                                                        width: 38px;
                                                        label: "‹";
                                                        clicked => { cal-prev-month(); }
                                                    }
                                                    Text {
                                                        text: cal-month-label;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        color: Theme.text;
                                                    }
                                                    GhostButton {
                                                        width: 38px;
                                                        label: "›";
                                                        clicked => { cal-next-month(); }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 0;
                                                    Text { width: 34px; text: I18n.week-days[0]; font-size: 10px; horizontal-alignment: center; color: Theme.muted; }
                                                    Text { width: 34px; text: I18n.week-days[1]; font-size: 10px; horizontal-alignment: center; color: Theme.muted; }
                                                    Text { width: 34px; text: I18n.week-days[2]; font-size: 10px; horizontal-alignment: center; color: Theme.muted; }
                                                    Text { width: 34px; text: I18n.week-days[3]; font-size: 10px; horizontal-alignment: center; color: Theme.muted; }
                                                    Text { width: 34px; text: I18n.week-days[4]; font-size: 10px; horizontal-alignment: center; color: Theme.muted; }
                                                    Text { width: 34px; text: I18n.week-days[5]; font-size: 10px; horizontal-alignment: center; color: Theme.warn-text; }
                                                    Text { width: 34px; text: I18n.week-days[6]; font-size: 10px; horizontal-alignment: center; color: Theme.warn-text; }
                                                }
                                                for row in cal-weeks: HorizontalLayout {
                                                    spacing: 0;
                                                    for c in row.cells: Rectangle {
                                                        width: 34px;
                                                        height: 32px;
                                                        cta := TouchArea {
                                                            mouse-cursor: c.ymd == "" ? default : pointer;
                                                            clicked => {
                                                                if (c.ymd != "") {
                                                                    cal-pick(c.ymd);
                                                                    cal-popup.close();
                                                                }
                                                            }
                                                        }
                                                        background: cta.has-hover && c.ymd != "" ? Theme.accent-tint-soft
                                                            : c.today ? Theme.accent-tint
                                                            : transparent;
                                                        border-radius: 6px;
                                                        Text {
                                                            text: c.label;
                                                            font-size: 12px;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                            width: parent.width;
                                                            height: parent.height;
                                                            color: !c.in-month ? Theme.muted : Theme.text;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    FieldLabel { text: I18n.t-field-quantity; }
                                    LineEdit {
                                        text <=> root.pkg-quantity;
                                        placeholder-text: I18n.t-quantity-placeholder;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    FieldLabel { text: I18n.t-field-price; }
                                    LineEdit {
                                        text <=> root.pkg-price;
                                        placeholder-text: I18n.t-price-placeholder;
                                        edited(text) => { root.pkg-form-edited(); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    FieldLabel { text: I18n.t-field-period; }
                                    LineEdit {
                                        text <=> root.pkg-period;
                                        placeholder-text: I18n.t-period-placeholder;
                                        edited(text) => { root.pkg-form-edited(); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    horizontal-stretch: 1;
                                    FieldLabel { text: I18n.t-field-purchased; }
                                    LineEdit {
                                        text <=> root.pkg-purchase-date;
                                        placeholder-text: I18n.t-optional-placeholder;
                                        edited(text) => { root.pkg-form-edited(); }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 3px;
                                    horizontal-stretch: 2;
                                    alignment: end;
                                    FieldLabel { text: I18n.t-field-comment; }
                                    LineEdit {
                                        text <=> root.pkg-note;
                                        placeholder-text: I18n.t-optional-placeholder;
                                    }
                                }
                            }

                            Text {
                                text: root.pkg-validation;
                                font-size: 12px;
                                color: root.pkg-validation-color;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                GhostButton {
                                    label: I18n.t-photo-btn;
                                    clicked => { root.pick-photo(); }
                                }
                                Text {
                                    text: I18n.t-quick-label;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    color: Theme.muted;
                                }
                                GhostButton {
                                    label: I18n.t-quick-6m;
                                    clicked => { root.pkg-quick(6); }
                                }
                                GhostButton {
                                    label: I18n.t-quick-1y;
                                    clicked => { root.pkg-quick(12); }
                                }
                                GhostButton {
                                    label: I18n.t-quick-2y;
                                    clicked => { root.pkg-quick(24); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if (root.pkg-editing): GhostButton {
                                    label: I18n.t-cancel;
                                    clicked => { root.pkg-cancel-edit(); }
                                }
                                AccentButton {
                                    label: root.pkg-editing ? I18n.t-save-pkg : I18n.t-add-pkg;
                                    enabled: root.pkg-save-enabled;
                                    clicked => { root.pkg-save(); }
                                }
                            }
                        }
                    }
                }

                // клик вне попапа автодополнения закрывает его — иначе он
                // перекрывает поля формы и перехватывает клики
                if (root.has-selection && root.suggestions.length > 0): TouchArea {
                    x: 0;
                    y: 88px;
                    width: parent.width;
                    height: parent.height - 88px;
                    clicked => { root.suggestions = []; }
                }

                if (root.has-selection && root.suggestions.length > 0): Rectangle {
                    x: 12px;
                    y: 88px;
                    width: parent.width - 24px;
                    height: min(root.suggestions.length, 6) * 30px + 8px;
                    border-radius: 8px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.accent;
                    clip: true;

                    VerticalLayout {
                        padding: 4px;
                        for s in root.suggestions: Rectangle {
                            height: 28px;
                            border-radius: 5px;
                            background: sta.has-hover ? Theme.accent-tint-soft : transparent;
                            sta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.suggestion-picked(s); }
                            }
                            Text {
                                text: s;
                                x: 10px;
                                width: parent.width - 20px;
                                vertical-alignment: center;
                                font-size: 13px;
                                color: Theme.text;
                            }
                        }
                    }
                }
            }
        }

        // ===== Статусная строка =====
        VerticalLayout {
            spacing: 2px;
            vertical-stretch: 0;

            // Ошибка — отдельной строкой с переносом: длинный текст (путь,
            // причина I/O) читается целиком и держится, пока не появится
            // следующая успешная операция (её сообщение вернётся в строку ниже)
            if (root.save-error): Text {
                text: root.status-message;
                font-size: 12px;
                wrap: word-wrap;
                color: Theme.danger-text;
            }

            HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 0;
            Text {
                text: I18n.t-warn-prefix;
                font-size: 12px;
                vertical-alignment: center;
                color: Theme.muted;
            }
            SpinBox {
                width: 95px;
                minimum: 5;
                maximum: 365;
                value <=> root.warn-days;
                edited(value) => { root.warn-days-changed(value); }
            }
            Text {
                text: I18n.t-warn-suffix;
                font-size: 12px;
                vertical-alignment: center;
                color: Theme.muted;
            }
            GhostButton {
                label: I18n.t-undo;
                enabled: root.can-undo;
                clicked => { root.undo-history(); }
            }
            GhostButton {
                label: I18n.t-redo;
                enabled: root.can-redo;
                clicked => { root.redo-history(); }
            }
            Rectangle { width: 1px; height: 22px; background: Theme.hairline; }
            GhostButton {
                label: I18n.t-journal;
                clicked => { root.open-journal(); }
            }
            GhostButton {
                label: I18n.t-shopping;
                clicked => { root.open-shopping(); }
            }
            GhostButton {
                label: I18n.t-reports;
                clicked => { root.open-reports(); }
            }
            GhostButton {
                label: I18n.t-backups;
                clicked => { root.open-backups(); }
            }
            GhostButton {
                label: I18n.t-import-csv;
                clicked => { root.open-import(); }
            }
            Rectangle { width: 1px; height: 22px; background: Theme.hairline; }
            GhostButton {
                label: I18n.t-export-csv;
                clicked => { root.export-csv(); }
            }
            GhostButton {
                label: I18n.t-theme;
                clicked => {
                    root.theme-dark = !root.theme-dark;
                    Palette.color-scheme = root.theme-dark ? ColorScheme.dark : ColorScheme.light;
                    root.theme-dark-changed(root.theme-dark);
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.status-message;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 2;
                // пока ошибка показана строкой выше, здесь её не дублируем
                visible: !root.save-error;
                color: Theme.muted;
            }
            }
        }
        }
    }
}

// ===== Окно отчётов: списания и покупки по годам =====
export component ReportWindow inherits Window {
    title: I18n.t-reports-title;
    default-font-family: I18n.font-family;
    min-width: 420px;
    min-height: 320px;
    preferred-width: 560px;
    preferred-height: 520px;
    in-out property <[string]> lines;
    callback close-clicked();

    background: Palette.color-scheme == ColorScheme.dark ? #1f2937 : #f8fafc;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Rectangle {
            vertical-stretch: 1;
            border-radius: 8px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.hairline;
            clip: true;

            VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                padding: 8px;

                ListView {
                    vertical-stretch: 1;
                    for line in root.lines: Rectangle {
                        height: 26px;
                        Text {
                            text: line;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            x: 8px;
                            width: parent.width - 16px;
                            color: Theme.text;
                        }
                    }
                }
            }

            if (root.lines.length == 0): Rectangle {
                width: 100%;
                height: 100%;
                Text {
                    width: 100%;
                    y: 40px;
                    horizontal-alignment: center;
                    text: I18n.t-rep-empty;
                    font-size: 13px;
                    color: Theme.muted;
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                text: I18n.t-close;
                clicked => { root.close-clicked(); }
            }
        }
    }
}

